# ============================================================================
#  JARVIS — your settings. Copy this file to ".env" and fill it in.
#  These are YOUR keys. Never share your .env. Nothing here is bundled.
# ============================================================================

# ── 1. THE BRAIN (required) ─────────────────────────────────────────────────
# JARVIS's intelligence. Default uses the Anthropic API directly (fast).
# Get a key at https://console.anthropic.com → Settings → API Keys (starts with sk-ant-).
ANTHROPIC_API_KEY=
JARVIS_ENGINE=fastlane
FASTLANE_MODEL=claude-sonnet-4-6
# (Advanced) Prefer your free Claude Code subscription instead of an API key?
# Set JARVIS_ENGINE=sdk and install Claude Code. See the README.

# ── 2. THE VOICE (required for spoken replies) ──────────────────────────────
# JARVIS speaks with ElevenLabs. Make a free account at https://elevenlabs.io
# → Profile → API Key. (Without a key, replies are text-only.)
ELEVENLABS_API_KEY=
# The JARVIS voice. Leave this as-is to sound like JARVIS, or paste your own voice ID.
ELEVENLABS_VOICE_ID=gJx1vCzNCD1EQHT212Ls
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── 3. YOU ──────────────────────────────────────────────────────────────────
# What JARVIS calls you. Personality lives in persona.md (edit that file).
USER_NAME=

# ── 4. SERVER ───────────────────────────────────────────────────────────────
JARVIS_PORT=8800
PERMISSION_MODE=bypassPermissions
# Phone-voice speech model: base / tiny / small. Downloads on first phone use.
WHISPER_MODEL=base

# ── 5. SPECIALIST TEAM (optional) ───────────────────────────────────────────
# JARVIS can hand big jobs to specialist agents, which run through Claude Code
# using whatever tools YOU have connected. Needs Claude Code installed.
CLAUDE_BIN=claude

# ── 6. LONG-TERM MEMORY (optional) ──────────────────────────────────────────
# Zero setup, no servers. This download ships a ready-made "memory" folder — point
# VAULT_DIR at it (e.g. C:\Users\You\Jarvis\memory) and JARVIS saves AND recalls over
# plain .md files there. Open that folder in Obsidian to read/edit your memories.
# Any other notes folder works too. Leave it blank to run without memory.
# (The setup wizard can fill this in for you. See OBSIDIAN-MEMORY.md.)
VAULT_DIR=

# ── 7. YOUR OWN DATA TOOLS (optional, advanced) ─────────────────────────────
# Connect your OWN Supabase database for the data tools. Leave blank to disable.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
