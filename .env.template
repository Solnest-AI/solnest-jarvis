# ============================================================
#  solnest-jarvis — YOUR KEYS
#
#  Paste your keys after the = signs. No quotes. No spaces.
#      GOOD:  ANTHROPIC_API_KEY=sk-ant-abc123
#      BAD:   ANTHROPIC_API_KEY = "sk-ant-abc123"
#
#  Save this file, then run JARVIS again (bash run.sh / run.bat).
#  NEVER paste a key into the chat window. NEVER commit this file.
#
#  Prefer to be asked the questions instead? Run `python configure.py`
#  and it writes this file for you.
# ============================================================

# JARVIS's brain  (REQUIRED)
# Get it: https://console.anthropic.com
ANTHROPIC_API_KEY=

# JARVIS's voice  (OPTIONAL — leave blank and Chrome's free voice is used)
# Get it: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Which voice he speaks in. Leave this exactly as it is to sound like JARVIS,
# or paste your own ElevenLabs voice id. If you set ELEVENLABS_API_KEY above,
# this must NOT be blank — a blank voice id turns the premium voice off with
# no error, and you get a silent JARVIS.
ELEVENLABS_VOICE_ID=gJx1vCzNCD1EQHT212Ls
ELEVENLABS_MODEL=eleven_turbo_v2_5

# What JARVIS calls you  (OPTIONAL — leave blank to skip)
USER_NAME=

# Folder for JARVIS's memories (a path, not a key)  (OPTIONAL — leave blank to skip)
# This download ships a ready-made "memory" folder. Point this at it, or at any
# notes folder. See OBSIDIAN-MEMORY.md.
VAULT_DIR=

# ------------------------------------------------------------
#  Everything below has a working default. Leave it alone
#  unless you know you want to change it.
# ------------------------------------------------------------

# How JARVIS thinks. "fastlane" uses your Anthropic API key directly (fast).
# "sdk" uses your Claude Code subscription instead of an API key.
JARVIS_ENGINE=fastlane
FASTLANE_MODEL=claude-sonnet-4-6

# Which port the local server listens on (http://localhost:8800).
JARVIS_PORT=8800

# How much JARVIS is allowed to do without asking. "bypassPermissions" lets the
# specialist agents run their tools without stopping to confirm each one, which
# includes the Mac and Chrome control modules. Change it to "default" if you
# would rather approve each action.
PERMISSION_MODE=bypassPermissions

# Phone-voice speech model: base / tiny / small. Downloads on first phone use.
WHISPER_MODEL=base

# The Claude Code executable, for the specialist team  (OPTIONAL)
CLAUDE_BIN=claude

# Your own Supabase (optional)  (OPTIONAL — leave blank to skip)
# Get it: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Your Supabase project ref (optional)  (OPTIONAL — leave blank to skip)
# Get it: Supabase project settings
SUPABASE_PROJECT_REF=
